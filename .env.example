PGUSER=dealerhub
PGPASSWORD=
PGDATABASE=dealerhub
PGHOST=localhost
PGPORT=5432

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Required — app refuses to start without a random value >= 32 chars:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# atoloan-backend (dev.sh runs it on 8000)
ATOLOAN_BACKEND_BASE_URL=http://localhost:8000
# Must equal atoloan-backend's SERVICE_TOKEN
SERVICE_TOKEN=
# Local http dev only; leave unset (true) anywhere with HTTPS
AUTH_COOKIE_SECURE=false
ENABLE_DOCS=true
